<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F141C"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_symbol"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BTCUSDT"
            android:textColor="#00F0FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$65,420.50"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_vpin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#33FF4D6D"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="VPIN %78 TOXIC!"
            android:textColor="#FF4D6D"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_return"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Net: +5.7R"
            android:textColor="#1FD67A"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_strategy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#1A222D"
        android:padding="6dp"
        android:text="AL (LONG) · 🔥 KAPLAN KAPAN"
        android:textColor="#FFD166"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
